# Telegram
BOT_TOKEN=your_bot_token_here

# Debug
DEBUG=false

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Admins
ADMIN_IDS=[123456789]

# Database
# SQLite (development): DATABASE_URL=sqlite+aiosqlite:///./data/dano.db
# PostgreSQL (production): DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/dano.db

# Required Telegram channel (optional; leave empty to disable membership gating)
REQUIRED_CHANNEL_ID=

# Rate limiting (requests per minute, per Telegram user)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MINUTE=20
RATE_LIMIT_ADMIN_PER_MINUTE=60
